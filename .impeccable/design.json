      "description": "Default white sticker pill; presses flat on tap.",
      "html": "<button class=\"ds-btn\">Open game again</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:48px;padding:.6rem 1.25rem;border:3px solid var(--ink,#2b1b3d);border-radius:999px;background:#fff;color:var(--ink,#2b1b3d);font-family:var(--font-fredoka),Fredoka,ui-rounded,system-ui,sans-serif;font-weight:600;font-size:1.0625rem;line-height:1.1;box-shadow:4px 4px 0 var(--ink,#2b1b3d);cursor:pointer;transition:transform 140ms cubic-bezier(.16,1,.3,1),box-shadow 140ms cubic-bezier(.16,1,.3,1),background-color 140ms}.ds-btn:hover{transform:translate(-1px,-1px);box-shadow:5px 5px 0 var(--ink,#2b1b3d)}.ds-btn:active{transform:translate(4px,4px);box-shadow:0 0 0 var(--ink,#2b1b3d);transition-duration:40ms}.ds-btn:focus-visible{outline:3px solid var(--focus,#6a3df0);outline-offset:3px}"
    },
